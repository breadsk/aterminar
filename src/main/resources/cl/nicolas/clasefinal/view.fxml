<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.GridPane?>
<VBox spacing="15" styleClass="root-container"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cl.nicolas.clasefinal.controller.PokemonController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label text="Centro Pokemon - Recepcion de Entrenadores" styleClass="title-label" />

    <GridPane hgap="12" vgap="10" styleClass="form-grid">
        <!-- Fila 0: Tipo -->
        <Label text="Tipo de Pokémon:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipo" styleClass="combo-box" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Fila 1: Nombre -->
        <Label text="Nombre (apodo):" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNombre" styleClass="text-input" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Fila 2: Nivel -->
        <Label text="Nivel (1-100):" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNivel" styleClass="text-input" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Fila 3: Peso -->
        <Label text="Peso (kg):" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPeso" styleClass="text-input" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Fila 4: Especie (PokemonAgua) -->
        <Label text="Especie:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEspecie" styleClass="text-input" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Fila 5: Opción Específica -->
        <CheckBox fx:id="chkEspecifico" styleClass="custom-checkbox" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <!-- Fila 6: Intercambio -->
        <CheckBox fx:id="chkIntercambio" text="Disponible para Intercambio" styleClass="custom-checkbox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

        <Button
            text="Registrar Pokemon"
            onAction="#handleRegistrar"
            styleClass="button-primary"
            GridPane.rowIndex="7"
            GridPane.columnIndex="1"
        />

    </GridPane>

    <TableView fx:id="tblPokemones" styleClass="table-view" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colTIpo" text="Tipo" prefWidth="110"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="colNivel" text="Nivel" prefWidth="60"/>
            <TableColumn fx:id="colPeso" text="Peso (KG)" prefWidth="80"/>
            <TableColumn fx:id="colCosto" text="Costo Curacion" prefWidth="120"/>
        </columns>
    </TableView>

</VBox>
